    {
      "name": "subir_archivo",
      "description": "Firma la subida de un archivo que está en el equipo (Claude Code, Cowork): suba los bytes a la URL que vuelve y use su carga en el comando del destino. En claude.ai web no hay archivo local: lleve a la persona a la pantalla del destino, que tiene su botón de subir.",
      "inputSchema": {
        "$defs": {
          "JsonValue": {}
        },
        "properties": {
          "empresa": {
            "maxLength": 100,
            "pattern": "^[a-z0-9-]+$",
            "title": "Empresa",
            "type": "string"
          },
          "operacion": {
            "description": "operationId de una ruta `…/subida` de la guía del módulo.",
            "title": "Operacion",
            "type": "string"
          },
          "cuerpo": {
            "$ref": "#/$defs/JsonValue",
            "description": "El de esa subida en la guía: nombre, tipo y tamaño."
          },
          "parametros": {
