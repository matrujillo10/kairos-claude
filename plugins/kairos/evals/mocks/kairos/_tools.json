{
  "tools": [
    {
      "name": "empresas",
      "description": "Las empresas en que la cuenta trabaja: la suya, o la cartera de su aliado, por páginas.",
      "inputSchema": {
        "properties": {
          "pagina": {
            "default": 1,
            "description": "De la cartera de un aliado.",
            "maximum": 100000,
            "minimum": 1,
            "title": "Pagina",
            "type": "integer"
          },
          "texto": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Nombre o NIT.",
            "title": "Texto"
          }
        },
        "title": "empresasArguments",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "EmpresaDeLaCuenta": {
            "additionalProperties": false,
            "properties": {
              "slug": {
                "description": "Nombre corto de la empresa: va en `empresa` de `consultar`.",
                "title": "Slug",
                "type": "string"
              },
              "razon_social": {
                "title": "Razon Social",
                "type": "string"
              }
            },
            "required": [
              "slug",
              "razon_social"
            ],
            "title": "EmpresaDeLaCuenta",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "`total` cuenta la cartera entera si la cuenta es de un aliado; `empresas`, solo la página pedida.",
        "properties": {
          "empresas": {
            "items": {
              "$ref": "#/$defs/EmpresaDeLaCuenta"
            },
            "title": "Empresas",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          },
          "pagina": {
            "description": "Con `total` mayor que las de esta página, pida la siguiente.",
            "title": "Pagina",
            "type": "integer"
          },
          "de_aliado": {
            "description": "De un aliado: las de su cartera; del personal de Inci, todas las de Kairos.",
            "title": "De Aliado",
            "type": "boolean"
          }
        },
        "required": [
          "empresas",
          "total",
          "pagina",
          "de_aliado"
        ],
        "title": "EmpresasDeLaCuenta",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "leer_guia",
      "description": "La guía de un módulo (qué se hace, lo legal, consultas y comandos) o el cuerpo de uno de sus comandos.",
      "inputSchema": {
        "$defs": {
          "SeccionDeLaGuia": {
            "enum": [
              "intencion",
              "consultas",
              "comandos"
            ],
            "title": "SeccionDeLaGuia",
            "type": "string"
          }
        },
        "properties": {
          "modulo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Módulo del índice; sin él, solo el índice.",
            "title": "Modulo"
          },
          "seccion": {
            "anyOf": [
              {
                "$ref": "#/$defs/SeccionDeLaGuia"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Solo esa parte de la guía."
          },
          "operacion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "operationId: el cuerpo de ese comando.",
            "title": "Operacion"
          }
        },
        "title": "leer_guiaArguments",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "JsonValue": {}
        },
        "additionalProperties": false,
        "description": "Sin `modulo`, el índice; con él, su guía o una sección; con `operacion`, el cuerpo de ese comando.",
        "properties": {
          "indice": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Módulo → título de su guía; `leer_guia` recibe el módulo.",
            "title": "Indice"
          },
          "modulo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Modulo"
          },
          "texto": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Texto"
          },
          "operacion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Operacion"
          },
          "cuerpo": {
            "$ref": "#/$defs/JsonValue",
            "default": null,
            "description": "JSON Schema del cuerpo; multipart lleva `carga:<id>`."
          },
          "multipart": {
            "default": false,
            "title": "Multipart",
            "type": "boolean"
          }
        },
        "title": "Guias",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "consultar",
      "description": "Varias consultas de la guía en un solo llamado, en paralelo; cada una con su estado y su cuerpo.",
      "inputSchema": {
        "$defs": {
          "PedidoDeConsulta": {
            "additionalProperties": false,
            "properties": {
              "empresa": {
                "maxLength": 100,
                "pattern": "^[a-z0-9-]+$",
                "title": "Empresa",
                "type": "string"
              },
              "ruta": {
                "description": "Ruta bajo /e/{empresa} de una consulta de la guía del módulo, con sus ids, p. ej. `/sedes`.",
                "maxLength": 500,
                "pattern": "^(/|(/[A-Za-z0-9_:-][A-Za-z0-9_.:-]*)+)$",
                "title": "Ruta",
                "type": "string"
              },
              "parametros": {
                "additionalProperties": {
                  "maxLength": 200,
                  "type": "string"
                },
                "description": "Parámetros de query que la consulta acepta, según su guía.",
                "propertyNames": {
                  "maxLength": 200
                },
                "title": "Parametros",
                "type": "object"
              },
              "campos": {
                "anyOf": [
                  {
                    "items": {
                      "maxLength": 120,
                      "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*$",
                      "type": "string"
                    },
                    "maxItems": 20,
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Solo estas llaves del cuerpo, con punto para entrar: `autoevaluacion.puntaje`, `pendientes`.",
                "title": "Campos"
              }
            },
            "required": [
              "empresa",
              "ruta"
            ],
            "title": "PedidoDeConsulta",
            "type": "object"
          }
        },
        "properties": {
          "pedidos": {
            "items": {
              "$ref": "#/$defs/PedidoDeConsulta"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Pedidos",
            "type": "array"
          }
        },
        "required": [
          "pedidos"
        ],
        "title": "consultarArguments",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "EmpresaDeLaCuenta": {
            "additionalProperties": false,
            "properties": {
              "slug": {
                "description": "Nombre corto de la empresa: va en `empresa` de `consultar`.",
                "title": "Slug",
                "type": "string"
              },
              "razon_social": {
                "title": "Razon Social",
                "type": "string"
              }
            },
            "required": [
              "slug",
              "razon_social"
            ],
            "title": "EmpresaDeLaCuenta",
            "type": "object"
          },
          "JsonValue": {},
          "PedidoRechazado": {
            "description": "Por qué un pedido del lote no llegó a la API.",
            "enum": [
              "consulta_no_permitida",
              "guia_desconocida",
              "accion_desconocida",
              "parametros_de_la_ruta",
              "cuerpo_demasiado_grande",
              "es_legal",
              "no_es_legal",
              "sin_pantalla",
              "no_intentada",
              "no_es_subida",
              "importador_desconocido"
            ],
            "title": "PedidoRechazado",
            "type": "string"
          },
          "ResultadoDeConsulta": {
            "additionalProperties": false,
            "description": "`estado` es el HTTP de la API; un pedido que no llegó a ella dice su `rechazo`.",
            "properties": {
              "empresa": {
                "title": "Empresa",
                "type": "string"
              },
              "ruta": {
                "title": "Ruta",
                "type": "string"
              },
              "estado": {
                "title": "Estado",
                "type": "integer"
              },
              "cuerpo": {
                "$ref": "#/$defs/JsonValue",
                "default": null
              },
              "rechazo": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/PedidoRechazado"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "empresa",
              "ruta",
              "estado"
            ],
            "title": "ResultadoDeConsulta",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "empresas": {
            "description": "Cada empresa del pedido con su razón social: verifique que es donde la persona quiere operar.",
            "items": {
              "$ref": "#/$defs/EmpresaDeLaCuenta"
            },
            "title": "Empresas",
            "type": "array"
          },
          "resultados": {
            "description": "Uno por pedido, en el mismo orden.",
            "items": {
              "$ref": "#/$defs/ResultadoDeConsulta"
            },
            "title": "Resultados",
            "type": "array"
          }
        },
        "required": [
          "empresas",
          "resultados"
        ],
        "title": "ResultadosDelLote",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
